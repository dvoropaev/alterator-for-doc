<!DOCTYPE node PUBLIC
  "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <interface name="org.altlinux.alterator.control1">
    <doc:summary xml:lang="en_US">Provides backend methods to read a control facility descriptor, inspect its available states, get the current state, and set a new state.</doc:summary>
    <doc:summary xml:lang="ru_RU">Предоставляет методы бэкенда для чтения описания facility control, просмотра доступных состояний, получения текущего состояния и установки нового состояния.</doc:summary>
    <method name="Info">
      <doc:summary xml:lang="en_US">Returns contents of the .control descriptor for the current facility.</doc:summary>
      <doc:summary xml:lang="ru_RU">Возвращает содержимое файла-описателя `.control` для текущей facility.</doc:summary>
      <arg type="ay" name="stdout_bytes" direction="out">
        <doc:summary xml:lang="en_US">Contents of the facility .control file.</doc:summary>
        <doc:summary xml:lang="ru_RU">Содержимое файла `.control` для facility.</doc:summary>
        <doc:detail xml:lang="en_US">The helper reads the static entry from /usr/share/alterator/control or the autogenerated entry /etc/alterator/control/autogenerated-control-&lt;facility&gt;.control.</doc:detail>
        <doc:detail xml:lang="ru_RU">Помощник читает статическую запись из `/usr/share/alterator/control` или автосгенерированную запись `/etc/alterator/control/autogenerated-control-&lt;facility&gt;.control`.</doc:detail>
      </arg>
      <arg type="i" name="response" direction="out">
        <doc:summary xml:lang="en_US">Exit code of the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Код завершения.</doc:summary>
        <doc:detail xml:lang="en_US">0 — success, != 0 — error.</doc:detail>
        <doc:detail xml:lang="ru_RU">0 — успех, != 0 — ошибка.</doc:detail>
      </arg>
    </method>
    <method name="List">
      <doc:summary xml:lang="en_US">Lists available states for the current facility.</doc:summary>
      <doc:summary xml:lang="ru_RU">Перечисляет доступные состояния для текущей facility.</doc:summary>
      <arg type="as" name="stdout_strings" direction="out">
        <doc:summary xml:lang="en_US">State names returned by control &lt;facility&gt; list.</doc:summary>
        <doc:summary xml:lang="ru_RU">Имена состояний, возвращаемые командой `control &lt;facility&gt; list`.</doc:summary>
        <doc:detail xml:lang="en_US">The helper converts the original space-separated output to an array of strings.</doc:detail>
        <doc:detail xml:lang="ru_RU">Помощник преобразует исходный вывод со списком через пробел в массив строк.</doc:detail>
      </arg>
      <arg type="i" name="response" direction="out">
        <doc:summary xml:lang="en_US">Exit code of the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Код завершения.</doc:summary>
        <doc:detail xml:lang="en_US">0 — success, != 0 — error.</doc:detail>
        <doc:detail xml:lang="ru_RU">0 — успех, != 0 — ошибка.</doc:detail>
      </arg>
    </method>
    <method name="Get">
      <doc:summary xml:lang="en_US">Returns the current state of the facility.</doc:summary>
      <doc:summary xml:lang="ru_RU">Возвращает текущее состояние facility.</doc:summary>
      <arg type="ay" name="stdout_bytes" direction="out">
        <doc:summary xml:lang="en_US">State returned by control &lt;facility&gt; status.</doc:summary>
        <doc:summary xml:lang="ru_RU">Состояние, возвращаемое командой `control &lt;facility&gt; status`.</doc:summary>
      </arg>
      <arg type="as" name="stderr_strings" direction="out">
        <doc:summary xml:lang="en_US">Diagnostics from the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Диагностические сообщения помощника.</doc:summary>
      </arg>
      <arg type="i" name="response" direction="out">
        <doc:summary xml:lang="en_US">Exit code of the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Код завершения.</doc:summary>
        <doc:detail xml:lang="en_US">0 — success, != 0 — error.</doc:detail>
        <doc:detail xml:lang="ru_RU">0 — успех, != 0 — ошибка.</doc:detail>
      </arg>
    </method>
    <method name="Set">
      <doc:summary xml:lang="en_US">Sets a new state for the facility.</doc:summary>
      <doc:summary xml:lang="ru_RU">Устанавливает новое состояние для facility.</doc:summary>
      <arg type="s" name="status" direction="in">
        <doc:summary xml:lang="en_US">State value passed to control &lt;facility&gt;.</doc:summary>
        <doc:summary xml:lang="ru_RU">Значение состояния, передаваемое в `control &lt;facility&gt;`.</doc:summary>
        <doc:detail xml:lang="en_US">The exact set of accepted values depends on the selected facility and can be obtained with method List.</doc:detail>
        <doc:detail xml:lang="ru_RU">Точный набор допустимых значений зависит от выбранной facility и может быть получен методом List.</doc:detail>
      </arg>
      <arg type="as" name="stderr_strings" direction="out">
        <doc:summary xml:lang="en_US">Diagnostics from the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Диагностические сообщения помощника.</doc:summary>
      </arg>
      <arg type="i" name="response" direction="out">
        <doc:summary xml:lang="en_US">Exit code of the helper.</doc:summary>
        <doc:summary xml:lang="ru_RU">Код завершения.</doc:summary>
        <doc:detail xml:lang="en_US">0 — success, != 0 — error.</doc:detail>
        <doc:detail xml:lang="ru_RU">0 — успех, != 0 — ошибка.</doc:detail>
      </arg>
    </method>
  </interface>
</node>
